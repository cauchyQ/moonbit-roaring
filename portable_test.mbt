///|
test "portable format preserves bitmap members" {
  let original = @moonbit-roaring.RoaringBitmap::from_array([
    0, 1, 65535, 65536, 2147483647,
  ]).unwrap()
  let bytes = original.serialize_portable()
  let decoded = @moonbit-roaring.decode_portable(bytes).unwrap()
  assert_eq(decoded.to_array(), original.to_array())
}

///|
test "portable decoder rejects truncated bytes" {
  assert_true(@moonbit-roaring.decode_portable(b"\x3a\x30") is Err(_))
}

///|
test "portable fixture generated by CRoaring" {
  // pyroaring 1.2.0, BitMap([0, 1, 65535, 65536, 2147483647]).serialize()
  let fixture = b"\x3a\x30\x00\x00\x03\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\xff\x7f\x00\x00\x20\x00\x00\x00\x26\x00\x00\x00\x28\x00\x00\x00\x00\x00\x01\x00\xff\xff\x00\x00\xff\xff"
  let bitmap = @moonbit-roaring.decode_portable(fixture).unwrap()
  assert_eq(bitmap.to_array(), [0, 1, 65535, 65536, 2147483647])
  assert_eq(bitmap.serialize_portable(), fixture)
}
