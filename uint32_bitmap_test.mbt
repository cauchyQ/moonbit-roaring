///|
test "unsigned values cross all shard boundaries" {
  let values : Array[UInt32] = [
    0U, 1073741823U, 1073741824U, 2147483647U, 2147483648U, 3221225472U, 4294967295U,
  ]
  let mut bitmap = @moonbit-roaring.UInt32Bitmap::new()
  for value in values {
    bitmap = bitmap.add(value)
  }
  assert_eq(bitmap.cardinality(), 7UL)
  for i in 0..<values.length() {
    assert_true(bitmap.contains(values[i]))
    assert_eq(bitmap.rank(values[i]), (i + 1).to_uint64())
    assert_eq(bitmap.select(i.to_uint64()), Some(values[i]))
  }
  assert_eq(bitmap.select(7UL), None)
  let smaller = bitmap.remove(4294967295U)
  assert_true(bitmap.contains(4294967295U))
  assert_true(!smaller.contains(4294967295U))
  assert_eq(bitmap.difference(smaller).cardinality(), 1UL)
  assert_eq(bitmap.intersection(smaller).cardinality(), 6UL)
  assert_eq(smaller.union(bitmap).cardinality(), 7UL)
}

///|
test "unsigned portable fixture generated by CRoaring" {
  let fixture = b"\x3a\x30\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x80\x00\x00\xff\xff\x00\x00\x20\x00\x00\x00\x22\x00\x00\x00\x24\x00\x00\x00\x00\x00\x00\x00\xff\xff"
  let bitmap = @moonbit-roaring.decode_portable_uint32(fixture).unwrap()
  assert_eq(bitmap.cardinality(), 3UL)
  assert_eq(bitmap.select(1UL), Some(2147483648U))
  assert_eq(bitmap.select(2UL), Some(4294967295U))
  assert_eq(bitmap.serialize_portable().unwrap(), fixture)
}

///|
test "compact portable run encoding survives a multi-container roundtrip" {
  let bitmap = @moonbit-roaring.UInt32Bitmap::new()
    .add_range(0UL, 10000UL)
    .unwrap()
    .add_range(65536UL, 75536UL)
    .unwrap()
    .add_range(131072UL, 141072UL)
    .unwrap()
    .add_range(196608UL, 206608UL)
    .unwrap()
    .add(4294967295U)
  let compact = bitmap.serialize_portable_compact()
  assert_true(compact.length() < bitmap.serialize_portable().unwrap().length())
  let restored = @moonbit-roaring.decode_portable_uint32(compact).unwrap()
  assert_eq(restored.xor(bitmap).cardinality(), 0UL)
}

///|
test "unsigned ranges cross boundaries and include maximum" {
  let bitmap = @moonbit-roaring.UInt32Bitmap::new()
    .add_range(2147483646UL, 2147483650UL)
    .unwrap()
    .add_range(4294967295UL, 4294967296UL)
    .unwrap()
  assert_eq(bitmap.cardinality(), 5UL)
  assert_true(bitmap.contains(2147483648U))
  assert_true(bitmap.contains(4294967295U))
  let removed = bitmap.remove_range(2147483647UL, 2147483649UL).unwrap()
  assert_eq(removed.cardinality(), 3UL)
  assert_true(!removed.contains(2147483648U))
  assert_true(bitmap.add_range(0UL, 4294967297UL) is Err(_))
  assert_true(bitmap.remove_range(1UL, 0UL) is Err(_))
  let unchanged = bitmap.add_range(4294967296UL, 4294967296UL).unwrap()
  assert_eq(unchanged.xor(bitmap).cardinality(), 0UL)
  let maximum_removed = bitmap.remove_range(4294967295UL, 4294967296UL).unwrap()
  assert_true(!maximum_removed.contains(4294967295U))
}

///|
test "unsigned snapshot rejects incorrect baseline and dataset" {
  let first = @moonbit-roaring.UInt32Bitmap::new().add(4294967295U)
  let second = first.add(2147483648U)
  let base = @moonbit-roaring.UInt32Snapshot::new("index-a", 1UL, first)
  let target = @moonbit-roaring.UInt32Snapshot::new("index-a", 2UL, second)
  let patch = base.diff_to(target).unwrap()
  let wire = patch.serialize()
  let corrupted = wire.to_array()
  corrupted[52] = corrupted[52] ^ 1
  let bad_wire = @moonbit-roaring.decode_uint32_patch(
    Bytes::from_array(corrupted),
    "index-a",
  ).unwrap()
  assert_true(base.apply(bad_wire) is Err(_))
  let patch = @moonbit-roaring.decode_uint32_patch(wire, "index-a").unwrap()
  assert_true(@moonbit-roaring.decode_uint32_patch(wire, "index-b") is Err(_))
  assert_true(
    @moonbit-roaring.decode_uint32_patch(b"URP1", "index-a") is Err(_),
  )
  let updated = base.apply(patch).unwrap()
  assert_eq(updated.generation(), 2UL)
  assert_true(updated.bitmap().contains(2147483648U))
  let wrong = @moonbit-roaring.UInt32Snapshot::new("index-a", 1UL, second)
  assert_true(wrong.apply(patch) is Err(_))
  let other = @moonbit-roaring.UInt32Snapshot::new("index-b", 1UL, first)
  assert_true(other.apply(patch) is Err(_))
  assert_true(target.apply(patch) is Err(_))
}

///|
test "portable encoding exceeds the former million member limit" {
  let bitmap = @moonbit-roaring.UInt32Bitmap::new()
    .add_range(0UL, 1000001UL)
    .unwrap()
  let restored = @moonbit-roaring.decode_portable_uint32(
    bitmap.serialize_portable().unwrap(),
  ).unwrap()
  assert_eq(restored.cardinality(), 1000001UL)
  assert_eq(restored.select(1000000UL), Some(1000000U))
}
